NODE_ENV=development
PORT=4000
CLIENT_URL=http://localhost:5173

# MongoDB must be a replica set. `pnpm db:start` prints this URI for the local one.
MONGODB_URI=mongodb://127.0.0.1:27018/supportpilot-ai?directConnection=true&replicaSet=supportpilotRs

# Two different secrets, at least 24 characters each.
JWT_ACCESS_SECRET=replace-with-access-secret
JWT_REFRESH_SECRET=replace-with-refresh-secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Optional. Without a key the app answers from retrieved data only.
GEMINI_API_KEY=
# Comma-separated lists are tried in order.
GEMINI_CHAT_MODEL=gemini-flash-latest,gemini-2.5-flash-lite
GEMINI_ROUTER_MODEL=gemini-flash-lite-latest,gemini-2.5-flash-lite
# GEMINI_ROUTER_TIMEOUT_MS=12000
GEMINI_EMBEDDING_MODEL=gemini-embedding-001

# lexical | hybrid (hybrid needs embeddings and a vector index)
KNOWLEDGE_SEARCH_MODE=lexical

# Reverse-proxy hops to trust for client IPs; leave unset when not behind a proxy.
# TRUST_PROXY=1
