{
  "name": "supportpilot-ai",
  "version": "0.1.0",
  "private": true,
  "description": "Agentic customer-support platform built with LangGraph, Express, MongoDB and React.",
  "type": "module",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "pnpm --parallel --filter client --filter server dev",
    "db:start": "pnpm --filter server db:start",
    "db:stop": "pnpm --filter server db:stop",
    "lint": "pnpm --recursive lint",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "pnpm --recursive typecheck",
    "test": "pnpm --recursive test",
    "seed": "pnpm --filter server seed",
    "ingest:knowledge": "pnpm --filter server ingest:knowledge",
    "build": "pnpm --recursive build",
    "eval:live": "pnpm --filter server eval:live",
    "smoke": "node scripts/smoke.mjs",
    "e2e": "pnpm --filter client e2e"
  },
  "devDependencies": {
    "@eslint/js": "^9.36.0",
    "eslint": "^9.36.0",
    "prettier": "^3.6.2",
    "typescript-eslint": "^8.44.0"
  }
}
